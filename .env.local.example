# ─── AI CHAT (server-only) ───────────────────────────────────────────────────
# Anthropic API key — required for the Sarah chatbot. Server-side only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets API key for the live chatbot knowledge base. Optional — if
# missing the chatbot falls back to the hard-coded prompt in /api/chat/route.ts.
GOOGLE_SHEETS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── GHL / LEAD ROUTING (server-only) ────────────────────────────────────────
# GHL Premium Inbound Webhook URL. The chatbot POSTs structured leads here
# when the chat closes. Same URL is also intended for the Retell voice agent
# (its payload sets source: "voice_agent").
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/XXXXXXXXXXXX/webhook-trigger/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ─── ANALYTICS ───────────────────────────────────────────────────────────────
# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

# Meta Pixel ID (optional)
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id

# ─── RETELL (legacy slot — not currently wired) ──────────────────────────────
# Retell AI agent ID. ChatWidget.tsx does not yet use this — kept for future
# voice-call CTA wiring. The Retell agent itself should POST leads directly to
# GHL_WEBHOOK_URL with source: "voice_agent".
NEXT_PUBLIC_RETELL_AGENT_ID=your-retell-agent-id

# ─── INTAKE FORM CRM WEBHOOK (separate from GHL chatbot flow) ────────────────
# The /intake form posts here. Can point at the same GHL webhook if you also
# want intake-form submissions in GHL, but the brief leaves this out of scope.
NEXT_PUBLIC_CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/xxxxxxx

# ─── SITE ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://countrypublicadjusters.com
#this url is just for record it will not affect or autmoatically connect to the website/project
