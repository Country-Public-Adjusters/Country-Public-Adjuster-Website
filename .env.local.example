# ─── ANALYTICS ───────────────────────────────────────────────────────────────
# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

# ─── AI CHAT ─────────────────────────────────────────────────────────────────
# Chatbase chatbot ID (from app.chatbase.co → your bot → Settings → Embed)
NEXT_PUBLIC_CHATBASE_BOT_ID=your-chatbase-bot-id

# Retell AI agent ID (from your Retell dashboard — wire in ChatWidget.tsx)
NEXT_PUBLIC_RETELL_AGENT_ID=your-retell-agent-id

# ─── CRM WEBHOOK ─────────────────────────────────────────────────────────────
# Webhook URL for CRM lead submission (e.g. Zapier, Make, HubSpot, GoHighLevel)
NEXT_PUBLIC_CRM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/xxxxxxx

# ─── META / SOCIAL ───────────────────────────────────────────────────────────
# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id

# ─── SITE ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://countrypublicadjusters.com
